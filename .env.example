# Environment Variables Template
# Copy this to .env.local and fill in your values
# ⚠️  NEVER commit .env.local to git!

# Supabase Configuration
# Get these from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (direct for seeding)
# Get from Supabase → Project Settings → Database → Connection Pooler
POSTGRES_URL=your_postgres_url

# Admin Configuration
# Format: email1@example.com,email2@example.com
# Only these emails can access the admin panel
# Password must be: 8+ chars, 1 uppercase, 1 lowercase, 1 number, 1 special char
ADMIN_ALLOWED_EMAILS=your_admin_email@example.com

# Optional: Test bypass key (REMOVE in production!)
TEST_BYPASS_KEY=test-bypass-secret-123
